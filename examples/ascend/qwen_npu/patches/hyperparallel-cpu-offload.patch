+def _export_streaming_hf(model: nn.Module, tokenizer, export_dir: Path, shard_bytes: int = 2_000_000_000) -> None:
+    """Gather one tensor at a time and bound rank-zero export buffering.
+
+    Model and optimizer state remain intact so the same exporter is safe during
+    training. The index is published only after all weight shards are written.
+    """
+    rank_zero = dist.get_rank() == 0
+    if rank_zero:
+        export_dir.mkdir(parents=True, exist_ok=True)
+    pending = {}
+    pending_bytes = 0
+    total_bytes = 0
+    weight_map = {}
+    shard_number = 0
+
+    def flush() -> None:
+        nonlocal pending_bytes, shard_number
+        if not pending:
+            return
+        shard_number += 1
+        filename = f"model-{shard_number:05d}.safetensors"
+        save_file(pending, str(export_dir / filename), metadata={"format": "pt"})
+        weight_map.update({name: filename for name in pending})
+        pending.clear()
+        pending_bytes = 0
+
+    with torch.no_grad():
+        for name, value in model.state_dict().items():
+            gathered = _gather_full_state_dict({name: value}, cpu_offload=True)
+            if not rank_zero:
+                continue
+            tensor = gathered.pop(name)
+            size = tensor.numel() * tensor.element_size()
+            if pending and pending_bytes + size > shard_bytes:
+                flush()
+            # Shared/tied storage must be serialized independently across shards.
+            pending[name] = tensor.detach().contiguous().clone()
+            pending_bytes += size
+            total_bytes += size
+            del tensor
+        if rank_zero:
+            flush()
+            model.config.save_pretrained(str(export_dir))
+            if getattr(model, "generation_config", None) is not None:
+                model.generation_config.save_pretrained(str(export_dir))
+            if tokenizer is not None:
+                tokenizer.save_pretrained(str(export_dir))
+            index = {"metadata": {"total_size": total_bytes}, "weight_map": weight_map}
+            (export_dir / "model.safetensors.index.json").write_text(json.dumps(index, indent=2), encoding="utf-8")
+    if dist.get_world_size() > 1:
+        dist.barrier()
+
